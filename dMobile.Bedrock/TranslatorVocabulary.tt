<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Globalization" #>
<#@ import namespace="System.Resources" #>
<#@ import namespace="System.IO" #>
<#@ output extension=".cs" #>
<#
string path = this.Host.ResolvePath("Language\\dMobileTranslation.ENU.txt");
int padLength=70;
string dash = "-";
string[] autoGenerateWarning = {
        "This file has been automatically generated.",
        "Any changes to this file will be lost upon build.",
        "This enum was generated in a pre-build event for this project.",
        "Date: " + DateTime.Now,
        "Source: \"" + path + "\""
        };

string firstLastLine = string.Format("//+-{0}-+", dash.PadRight(padLength, '-'));
#>
#if MULTILANGUAGE
<#= firstLastLine.ToString() #>
<#
    int autoGenerateLineCount = autoGenerateWarning.Length;
    for (int i = 0; i < autoGenerateLineCount; ++i) {
#>
<#= string.Format("//| {0} |", autoGenerateWarning[i].PadRight(padLength, ' ')) #>
<#
        }
#>
<#= firstLastLine.ToString() #>
namespace dMobile.Bedrock
{
    using System;

    /// <summary>
    /// Words and messages that have alternate translations.
    /// </summary>
    public enum TranslatorVocabulary
    {
<#
    try
    {
        using (StreamReader sr = new StreamReader(path))
        {
            int i = 0;
            string line = "";
            while (!sr.EndOfStream)
            {
                line = sr.ReadLine();
                int splitIndex = line.IndexOf('=');
#>

        /// <summary>
        /// <#= line.Substring(splitIndex + 1) #>
        /// </summary>
        <#= line.Substring(0, splitIndex) #> = <#= i++ #>,
<#
            }
        }
    }
    catch (Exception e)
    {
#>
    Exception: <#= e.Message #>
<#
    }
#>


    }
}
#endif