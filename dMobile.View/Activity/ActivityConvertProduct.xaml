<?xml version="1.0" encoding="utf-8" ?>
<custompages:DMobileContentPage  xmlns:custompages="clr-namespace:dMobile.View.CustomPages" 
                                 xmlns="http://xamarin.com/schemas/2014/forms"
                                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                 xmlns:helpers="clr-namespace:dMobile.View.Helpers" 
                                 xmlns:customcontrols="clr-namespace:dMobile.View.CustomControls"
                                 xmlns:modal="clr-namespace:dMobile.View.CustomPages.Modal;assembly=dMobile.View"
                                 x:Class="dMobile.View.Activity.ActivityConvertProduct" x:DataType="modal:DMobileModal">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="OptionsMenu"
                     IconImageSource="{Binding OptionsIconSource}"
                     Clicked="OptionsMenu_Clicked" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <AbsoluteLayout VerticalOptions="Center">
            <Grid x:Name="GridContainer"
                  Padding="10"
                  AbsoluteLayout.LayoutFlags="All"
                  AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Frame VerticalOptions="Start" Grid.Row="0" BackgroundColor="{DynamicResource BorderColor}">
                    <ListView x:Name="ListViewDisplayExtraInfo"
                              SelectionMode="None"
                              HasUnevenRows="true"
                              IsEnabled="{Binding IsIndicatorRunning, Converter={helpers:BoolConverter}}"
                              SeparatorVisibility="None" >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="5,1,5,1">
                                        <Label Text="{Binding}" VerticalTextAlignment="Center"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Frame>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70*"/>
                        <ColumnDefinition Width="30*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CmdLocation"
                            Grid.Row="0"
                            Grid.Column="0"
                            Clicked="CmdLocation_Click"
                            IsEnabled="{Binding IsIndicatorRunning, Converter={helpers:BoolConverter}}"/>
                    <customcontrols:CustomPicker x:Name="BarCodeModifier1Picker"
                                                 Grid.Row="0"
                                                 Grid.Column="1"
                                                 Image="arrow_drop_down"
                                                 SelectedIndexChanged="BarCodeModifier1Picker_SelectedIndexChanged"
                                                 IsEnabled="{Binding IsIndicatorRunning, Converter={helpers:BoolConverter}}"/>
                    <Button x:Name="CmdSelectFromProduct"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Clicked="CmdSelectFromUnit_Click"
                            IsEnabled="{Binding IsIndicatorRunning, Converter={helpers:BoolConverter}}"/>
                    <Button x:Name="CmdSelectToProduct"
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Clicked="CmdSelectToUnit_Click"
                            IsEnabled="{Binding IsIndicatorRunning, Converter={helpers:BoolConverter}}"/>
                    <Button x:Name="CmdDetail"
                            Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Clicked="CmdDetail_Click"
                            IsEnabled="{Binding IsIndicatorRunning, Converter={helpers:BoolConverter}}"/>
                </Grid>
            </Grid>

            <ActivityIndicator IsVisible="{Binding IsIndicatorRunning}" 
                               IsRunning="{Binding IsIndicatorRunning}"
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</custompages:DMobileContentPage>