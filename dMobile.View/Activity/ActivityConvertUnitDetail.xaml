<?xml version="1.0" encoding="utf-8" ?>
<modal:DMobileModal
    xmlns:modal="clr-namespace:dMobile.View.CustomPages.Modal"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:dMobile.View.Helpers"
    xmlns:input="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
    x:Class="dMobile.View.Activity.ActivityConvertUnitDetail" x:DataType="modal:DMobileModal">
    <ContentPage.Content>
        <AbsoluteLayout VerticalOptions="Center">
            <Grid x:Name="GridContainer"
                  Padding="10"
                  AbsoluteLayout.LayoutFlags="All"
                  AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="65*"/>
                    <RowDefinition Height="20*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <Label x:Name="LblSkidNumber" Grid.Row="0" FontAttributes="Bold"/>

                <Frame VerticalOptions="Start"
                       Grid.Row="1"
                       Grid.Column="0"
                       BorderColor="{DynamicResource BorderColor}">
                    <ScrollView Orientation="Horizontal">
                        <Grid x:Name="GridMainActivity">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListView x:Name="ListViewMainActivity"
                                      ItemSelected="ListViewMainActivity_ItemSelected"
                                      HasUnevenRows="true"
                                      IsEnabled="{Binding IsIndicatorRunning, Converter={helpers:BoolConverter}}"
                                      Grid.Row="1"/>
                        </Grid>
                    </ScrollView>
                </Frame>

                <Frame VerticalOptions="Start" Grid.Row="2" BorderColor="{DynamicResource BorderColor}">
                    <ListView x:Name="ListViewDisplayExtraInfo" SelectionMode="None" HasUnevenRows="true"
                              IsEnabled="{Binding IsIndicatorRunning, Converter={helpers:BoolConverter}}"
                              SeparatorVisibility="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="5,1,5,1">
                                        <Label Text="{Binding}" VerticalTextAlignment="Center"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Frame>

                <Grid Grid.Row="3">
                    <Entry x:Name="TxtSearchDetail" Grid.Row="0" Grid.Column="0" TextChanged="TxtSearchHdr_TextChanged"
                           IsEnabled="{Binding IsIndicatorRunning, Converter={helpers:BoolConverter}}" />
                    <Button x:Name="CmdAddDetail"
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="Add Detail"
                            Clicked="CmdAddDetail_Click"
                            IsEnabled="{Binding IsIndicatorRunning, Converter={helpers:BoolConverter}}"/>
                </Grid>

                <Grid Grid.Row="4">
                    <ProgressBar x:Name="ProgBarMain" Grid.Row="0" Grid.Column="0" Visual="Default"></ProgressBar>
                </Grid>
            </Grid>

            <ActivityIndicator IsVisible="{Binding IsIndicatorRunning}" 
                               IsRunning="{Binding IsIndicatorRunning}"
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</modal:DMobileModal>