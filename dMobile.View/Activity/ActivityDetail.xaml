<?xml version="1.0" encoding="utf-8" ?>
<modal:DMobileModal
    xmlns:modal="clr-namespace:dMobile.View.CustomPages.Modal"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Helpers="clr-namespace:dMobile.View.Helpers"
    xmlns:input="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
    x:Class="dMobile.View.Activity.ActivityDetail">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="optionsMenu" IconImageSource="{Binding OptionsIconSource}" Clicked="OptionsMenu_Clicked" IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}"/>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <AbsoluteLayout VerticalOptions="Center">
            <Grid x:Name="gridContainer"
                  Padding="10"
                  AbsoluteLayout.LayoutFlags="All"
                  AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="65*"/>
                    <RowDefinition Height="20*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <Label x:Name="lblSkidNumber" Grid.Row="0" FontAttributes="Bold"/>

                <Frame VerticalOptions="Start" Grid.Row="1" Grid.Column="0" OutlineColor="{DynamicResource BorderColor}">
                    <ScrollView Orientation="Horizontal">
                        <Grid x:Name="GridMainActivity">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListView x:Name="ListViewMainActivity"
                                      ItemSelected="ListViewMainActivity_ItemSelected"
                                      HasUnevenRows="true"
                                      IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}"
                                      Grid.Row="1"/>
                        </Grid>
                    </ScrollView>
                </Frame>

                <Frame VerticalOptions="Start" Grid.Row="2" OutlineColor="{DynamicResource BorderColor}">
                    <ListView x:Name="ListViewDisplayExtraInfo" SelectionMode="None" HasUnevenRows="true" IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}" SeparatorVisibility="None" >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="5,1,5,1">
                                        <Label Text="{Binding}" VerticalTextAlignment="Center"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Frame>

                <Grid Grid.Row="3">
                    <Entry x:Name="txtSearchDetail"
                           Grid.Row="0"
                           Grid.Column="0"
                           TextChanged="TxtSearchHdr_TextChanged"
                           Focused="TxtSearchItem_Focused"
                           Unfocused="TxtSearchItem_Unfocused"                           
                           IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}"/>
                    <Button x:Name="cmdAddDetail"
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="Add Detail"
                            Clicked="CmdAddDetail_Click"
                            IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}"/>
                </Grid>

                <Grid Grid.Row="4">
                    <ProgressBar x:Name="progBarMain" Grid.Row="0" Grid.Column="0" Visual="Default"></ProgressBar>
                </Grid>
                
                <!--<Grid x:Name="gridButtonContainer" Grid.Row="3" Grid.ColumnSpan="2" IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}">-->
                    <!--<Button x:Name="cmdSelectSkid" Grid.Row="3" Grid.Column="0" Text="Select Skid" Clicked="CmdSelectSkid_Click" IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}"/>-->
                    
                    <!--<Button x:Name="cmdLocation" Grid.Row="1" Grid.Column="0" Text="Set Location" Clicked="CmdLocation_Click" IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}"/>
                    <Button x:Name="cmdAddSkid" Grid.Row="1" Grid.Column="1" Text="Add Skid" Clicked="CmdAddSkid_Click" IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}"/>-->
                <!--</Grid>-->
            </Grid>

            <ActivityIndicator IsVisible="{Binding IsPageLoading}" 
                               IsRunning="{Binding IsPageLoading}"
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</modal:DMobileModal>