<?xml version="1.0" encoding="utf-8" ?>
<page:DMobileContentPage
    xmlns:page="clr-namespace:dMobile.View.CustomPages"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Helpers="clr-namespace:dMobile.View.Helpers"
    x:Class="dMobile.View.Activity.ActivityHdr">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="optionsMenu" IconImageSource="{Binding OptionsIconSource}" Clicked="OptionsMenu_Clicked" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <AbsoluteLayout VerticalOptions="Center">
            <Grid x:Name="gridContainer"
                  Padding="10"
                  AbsoluteLayout.LayoutFlags="All"
                  AbsoluteLayout.LayoutBounds="0,0,1,1">
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="70*"/>
                    <RowDefinition Height="18*"/>
                    <RowDefinition Height="12*"/>
                </Grid.RowDefinitions>

                <Frame VerticalOptions="Start" Grid.Row="0" OutlineColor="{DynamicResource BorderColor}">
                    <ScrollView Orientation="Horizontal">
                        <Grid x:Name="GridMainActivity">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListView x:Name="ListViewMainActivity"
                                      ItemSelected="ListViewMainActivity_ItemSelected"
                                      HasUnevenRows="True"
                                      IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"
                                      Grid.Row="1"
                                      VerticalScrollBarVisibility="Always"
                                      HorizontalScrollBarVisibility="Always" SelectionMode="Single" />
                        </Grid>
                    </ScrollView>
                </Frame>

                <Frame VerticalOptions="Start" Grid.Row="1" OutlineColor="{DynamicResource BorderColor}">
                    <ListView x:Name="ListViewDisplayExtraInfo"
                              SelectionMode="None"
                              HasUnevenRows="True"
                              IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"
                              SeparatorVisibility="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="5,1,5,1">
                                        <Label Text="{Binding}" VerticalOptions="Center"></Label>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Frame>
                
                <Grid Grid.Row="2">
                    <Entry x:Name="txtSearchHdr"
                           Grid.Row="0"
                           Grid.Column="0"
                           TextChanged="TxtSearchHdr_TextChanged"
                           Focused="TxtSearchHdr_Focused"
                           Unfocused="TxtSearchHdr_Unfocused"
                           IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                   
                    <Button x:Name="cmdAdd"
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="Add"
                            Clicked="CmdAdd_Click"
                            IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                </Grid>
            </Grid>

            <!-- This control takes focus away from the current control. Watch for this. -->
            <ActivityIndicator IsVisible="{Binding IsIndicatorRunning}" 
                               IsRunning="{Binding IsIndicatorRunning}"
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</page:DMobileContentPage>