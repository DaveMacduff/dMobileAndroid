<?xml version="1.0" encoding="utf-8" ?>
<page:DMobileContentPage
    xmlns:page="clr-namespace:dMobile.View.CustomPages"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Helpers="clr-namespace:dMobile.View.Helpers"
    x:Class="dMobile.View.Activity.ActivityHdr">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="optionsMenu" IconImageSource="{Binding OptionsIconSource}" Clicked="OptionsMenu_Clicked" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <AbsoluteLayout VerticalOptions="Center">
            <Grid x:Name="gridContainer"
                  Padding="10"
                  AbsoluteLayout.LayoutFlags="All"
                  AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="65*"/>
                    <RowDefinition Height="20*"/>
                    <RowDefinition Height="15*"/>
                    <!--<RowDefinition Height="3*"/>-->
                </Grid.RowDefinitions>

                <Frame VerticalOptions="Start" Grid.Row="0" OutlineColor="{DynamicResource BorderColor}">
                    <ScrollView Orientation="Horizontal">
                        <Grid x:Name="GridMainActivity">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListView x:Name="ListViewMainActivity"
                                      ItemSelected="ListViewMainActivity_ItemSelected"
                                      HasUnevenRows="True"
                                      IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}"
                                      Grid.Row="1"
                                      Focused="ListView_Focused"
                                      Unfocused="ListView_Focused"
                                      VerticalScrollBarVisibility="Always"
                                      HorizontalScrollBarVisibility="Always" SelectionMode="Single" />
                        </Grid>
                    </ScrollView>
                </Frame>

                <Frame VerticalOptions="Start" Grid.Row="1" OutlineColor="{DynamicResource BorderColor}">
                    <ListView x:Name="ListViewDisplayExtraInfo"
                              SelectionMode="None"
                              HasUnevenRows="True"
                              IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}"
                              SeparatorVisibility="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="5,1,5,1">
                                        <Label Text="{Binding}" VerticalOptions="Center"
                                               Focused="ListDisplay_Focused"
                                               Unfocused="ListDisplay_Unfocused"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Frame>

                <!--
                <Button x:Name="cmdFilter" Grid.Row="2" Grid.Column="1" Text="Filter" Clicked="cmdFilter_Click" IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}"/>
                -->
                
                <Grid Grid.Row="2">
                    <Entry x:Name="txtSearchHdr"
                           Grid.Row="0"
                           Grid.Column="0"
                           TextChanged="TxtSearchHdr_TextChanged"
                           Focused="TxtSearchItem_Focused"
                           Unfocused="TxtSearchItem_Unfocused"
                           IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}"/>
                   
                    <Button x:Name="cmdAdd"
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="Add"
                            Clicked="CmdAdd_Click"
                            Focused="CmdAdd_Focused"
                            Unfocused="CmdAdd_Unfocused"
                            IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}"/>
                </Grid>
                <!--
                <Grid Grid.Row="3">
                    <ProgressBar x:Name="progBarMain" Grid.Row="0" Grid.Column="0" Visual="Default"></ProgressBar>
                </Grid>
                -->
            </Grid>

            <ActivityIndicator IsVisible="{Binding IsPageLoading}" 
                               IsRunning="{Binding IsPageLoading}"
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</page:DMobileContentPage>