<?xml version="1.0" encoding="utf-8" ?>
<modal:DMobileModal  
    xmlns:modal="clr-namespace:dMobile.View.CustomPages.Modal"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Helpers="clr-namespace:dMobile.View.Helpers" 
    xmlns:customcontrols="clr-namespace:dMobile.View.CustomControls"
    x:Class="dMobile.View.Activity.ActivityHdrReturnsFilter">
    <ContentPage.Content>
        <AbsoluteLayout>
            <Grid Padding="10" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label x:Name="lblApplyEnteredDate" VerticalOptions="CenterAndExpand" FontAttributes="Bold" Grid.Row="0" Grid.Column="0"/>
                    <customcontrols:CustomSwitch x:Name="chkApplyEnteredDate" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Grid.Row="0" Grid.Column="1"/>

                    <Label x:Name="lblApplyReturnedDate" VerticalOptions="CenterAndExpand" FontAttributes="Bold" Grid.Row="1" Grid.Column="0"/>
                    <customcontrols:CustomSwitch x:Name="chkApplyReturnedDate" VerticalOptions="CenterAndExpand" HorizontalOptions="EndAndExpand" Grid.Row="1" Grid.Column="1"/>
                </Grid>

                <ScrollView Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label x:Name="lblEnteredDate" Grid.Row="0" Grid.Column="0" FontAttributes="Bold" VerticalOptions="CenterAndExpand"/>
                        <DatePicker x:Name="dtpEnteredDate" Grid.Row="0" Grid.Column="1"/>

                        <Label x:Name="lblReturnedDate" Grid.Row="1" Grid.Column="0" FontAttributes="Bold" VerticalOptions="CenterAndExpand"/>
                        <DatePicker x:Name="dtpReturnedDate" Grid.Row="1" Grid.Column="1"/>

                        <Label x:Name="lblSort" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" VerticalOptions="CenterAndExpand"/>

                        <Label x:Name="lbl1" Grid.Row="3" Grid.Column="0" FontAttributes="Bold" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"/>
                        <customcontrols:CustomPicker x:Name="cboSortBy1" Grid.Row="3" Grid.Column="1" Image="arrow_drop_down" IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}"/>

                        <Label x:Name="lbl2" Grid.Row="4" Grid.Column="0" FontAttributes="Bold" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"/>
                        <customcontrols:CustomPicker x:Name="cboSortBy2" Grid.Row="4" Grid.Column="1" Image="arrow_drop_down" IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}"/>

                        <Label x:Name="lbl3" Grid.Row="5" Grid.Column="0" FontAttributes="Bold" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"/>
                        <customcontrols:CustomPicker x:Name="cboSortBy3" Grid.Row="5" Grid.Column="1" Image="arrow_drop_down" IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}"/>
                    </Grid>
                </ScrollView>

                <Grid Grid.Row="2">
                    <Button x:Name="btnSave" Grid.Row="0" Grid.Column="0" IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}" Clicked="btnSave_Clicked"/>
                    <Button x:Name="btnClose" Grid.Row="0" Grid.Column="1" IsEnabled="{Binding IsPageLoading, Converter={Helpers:BoolConverter}}" Clicked="btnClose_Clicked"/>
                </Grid>
            </Grid>

            <ActivityIndicator IsVisible="{Binding IsPageLoading}" 
                               IsRunning="{Binding IsPageLoading}"
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</modal:DMobileModal>