<?xml version="1.0" encoding="utf-8" ?>
<modal:DMobileModal  
    xmlns:modal="clr-namespace:dMobile.View.CustomPages.Modal"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="dMobile.View.Activity.ActivityItemPurchaseOrderWorkSheetEdit">
    <ContentPage.Content>
        <AbsoluteLayout VerticalOptions="Center">
            <Grid x:Name="gridContainer" Padding="10" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label x:Name="lblQty" Text="Quantity" Grid.Row="0" Grid.Column="0" VerticalOptions="CenterAndExpand" HorizontalOptions="Center"/>
                <Entry x:Name="txtAltQty" Grid.Row="0" Grid.Column="1" VerticalOptions="CenterAndExpand" Keyboard="Numeric"/>
                <Label x:Name="lblUnit" Text="KG" Grid.Row="0" Grid.Column="2" VerticalOptions="CenterAndExpand" HorizontalOptions="Center"/>

                <Frame VerticalOptions="Start" Grid.Row="1" Grid.ColumnSpan="3" OutlineColor="{DynamicResource BorderColor}">
                    <ListView x:Name="ListViewDisplayExtraInfo" SelectionMode="None" HasUnevenRows="True" SeparatorVisibility="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="5,1,5,1">
                                        <Label Text="{Binding}" VerticalTextAlignment="Center"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Frame>

                <Grid Grid.Row="2" Grid.ColumnSpan="3">
                    <Button x:Name="btnSave" Text="Save" Clicked="btnSave_Clicked" Grid.Row="0" Grid.Column="0"/>
                    <Button x:Name="btnCancel" Clicked="btnCancel_Clicked" Grid.Row="0" Grid.Column="1"/>
                </Grid>

            </Grid>

            <ActivityIndicator IsVisible="{Binding Loading}" 
                               IsRunning="{Binding Loading}"
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</modal:DMobileModal>