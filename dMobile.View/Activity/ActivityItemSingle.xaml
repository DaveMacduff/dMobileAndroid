<?xml version="1.0" encoding="utf-8" ?>
<modal:DMobileModal xmlns:modal="clr-namespace:dMobile.View.CustomPages.Modal"
                    xmlns="http://xamarin.com/schemas/2014/forms"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:Helpers="clr-namespace:dMobile.View.Helpers"
                    xmlns:customcontrols="clr-namespace:dMobile.View.CustomControls"
                    x:Class="dMobile.View.Activity.ActivityItemSingle">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="optionsMenu" IconImageSource="{Binding OptionsIconSource}" Clicked="OptionsMenu_Clicked" IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <AbsoluteLayout VerticalOptions="Center">
            <Grid Padding="10" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="45*"/>
                    <RowDefinition Height="25*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="15*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label x:Name="lblProductBCUnit" Grid.Row="0" Grid.Column="0" FontAttributes="Bold"/>
                    <Label x:Name="lblOrderedQuantity" Grid.Row="1" Grid.Column="0" FontAttributes="Bold"/>
                    <Label x:Name="lblShippedQuantity" Grid.Row="2" Grid.Column="0" FontAttributes="Bold"/>

                    <Label x:Name="lblIsItemComment" Grid.Row="0" Grid.Column="1" FontAttributes="Bold"/>

                </Grid>

                <Frame VerticalOptions="Start" Grid.Row="1" OutlineColor="{DynamicResource BorderColor}">
                    <ListView x:Name="ListViewDisplayExtraInfo" SelectionMode="None" HasUnevenRows="True" IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}" SeparatorVisibility="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="5,1,5,1">
                                        <Label Text="{Binding}" VerticalTextAlignment="Center"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Frame>

                <Grid x:Name="gridControls" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70*"/>
                        <ColumnDefinition Width="30*"/>
                    </Grid.ColumnDefinitions>

                    <Entry x:Name="txtSearchItem" Grid.Row="0" Grid.Column="0" Focused="txtSearchItem_GotFocus" TextChanged="txtSearchHdr_TextChanged" IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                    <customcontrols:CustomPicker x:Name="BarCodeModifier1Picker" Grid.Row="0" Grid.Column="1" Image="arrow_drop_down" SelectedIndexChanged="BarCodeModifier1Picker_SelectedIndexChanged" IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                    <!--<Button x:Name="cmdFilter" Grid.Row="0" Grid.Column="1" Clicked="CmdFilter_Clicked" IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>-->
                </Grid>

                <Grid Grid.Row="3">
                    <Button x:Name="cmdDetails" Grid.Row="0" Grid.Column="0" Clicked="CmdDetails_Click" IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                    <Button x:Name="cmdPrevious" Grid.Row="0" Grid.Column="1" Clicked="cmdPrevious_Click" IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                    <Button x:Name="cmdNext" Grid.Row="0" Grid.Column="2" Clicked="CmdNext_Click" IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                </Grid>
            </Grid>

            <ActivityIndicator IsVisible="{Binding IsIndicatorRunning}" 
                                   IsRunning="{Binding IsIndicatorRunning}"
                                   AbsoluteLayout.LayoutFlags="All" 
                                   AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</modal:DMobileModal>