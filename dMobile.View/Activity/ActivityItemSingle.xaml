<?xml version="1.0" encoding="utf-8" ?>
<modal:DMobileModal xmlns:modal="clr-namespace:dMobile.View.CustomPages.Modal"
                    xmlns="http://xamarin.com/schemas/2014/forms"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:Helpers="clr-namespace:dMobile.View.Helpers"
                    xmlns:customcontrols="clr-namespace:dMobile.View.CustomControls"
                    x:Class="dMobile.View.Activity.ActivityItemSingle">
    <ContentPage.Content>
        <AbsoluteLayout VerticalOptions="Center">
            <Grid Padding="10" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--Location-->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CmdSetLocation"
                            Grid.Row="0"
                            Grid.Column="0"
                            Clicked="CmdSetLocation_Click"
                            Text="Selected Location"
                            FontAttributes="Bold"
                            IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                </Grid>
                <!--Default location-->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="LblDefaultLocation"
                           Grid.Row="0"
                           Grid.Column="0"
                           FontAttributes="Bold"
                           Text="      Default"/>
                    <Label x:Name="LblDefaultLocationData"
                           Grid.Row="0"
                           Grid.Column="1"
                           Text="Unknown"/>
                </Grid>
                <!--Suggested location-->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="LblSuggestedLocation"
                           Grid.Row="0"
                           Grid.Column="0"
                           FontAttributes="Bold"
                           Text = "Suggested"/>
                    <Label x:Name="LblSuggestedLocationData"
                           Grid.Row="0"
                           Grid.Column="1"
                           Text = "Unknown"/>
                </Grid>
                <!--Skid and Modifier-->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70*"/>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="20*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CmdSetSkid"
                            Grid.Row="0"
                            Grid.Column="0"
                            Clicked="CmdSetSkid_Click"
                            FontAttributes="Bold"
                            Text="Selected Skid"
                            IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                    <Button x:Name="CmdClearSkid"
                            Grid.Row="0"
                            Grid.Column="1"
                            Clicked="CmdClearSkid_Clicked"
                            FontAttributes="Bold"
                            Text="Clr"
                            IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                    <customcontrols:CustomPicker x:Name="BarCodeModifier1Picker"
                                                 Grid.Row="0"
                                                 Grid.Column="2"
                                                 Image="arrow_drop_down"
                                                 SelectedIndexChanged="BarCodeModifier1Picker_SelectedIndexChanged"
                                                 IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                </Grid>
                <!--
                Product, BC, Unit
                Description, Size
                Brand
                -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="LblProductBcUnit"
                           Grid.Row="0"
                           Grid.Column="0"
                           FontAttributes="Bold"
                           Text="Product"/>
                    <Label x:Name="LblProductBcUnitData"
                           Grid.Row="0"
                           Grid.Column="1"
                           Text="Unknown"/>
                    <Label x:Name="LblDescriptionSize"
                           Grid.Row="1"
                           Grid.Column="0"
                           FontAttributes="Bold"
                           Text="     Desc"/>
                    <Label x:Name="LblDescriptionSizeData"
                           Grid.Row="1"
                           Grid.Column="1"
                           Text="Unknown"/>
                    <Label x:Name="LblBrand"
                           Grid.Row="2"
                           Grid.Column="0"
                           FontAttributes="Bold"
                           Text="   Brand"/>
                    <Label x:Name="LblBrandData"
                           Grid.Row="2"
                           Grid.Column="1"
                           Text="Unknown"/>
                </Grid>
                <!--
                Ordered / Expected / On hand
                Shipped / Received / Counted
                -->                
                <Grid Grid.Row="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="LblOrderedExpectedOnHand"
                           Grid.Row="0"
                           Grid.Column="0"
                           FontAttributes="Bold"
                           Text="Ordered"/>
                    <Label x:Name="LblOrderedExpectedOnHandData"
                           Grid.Row="0"
                           Grid.Column="1"
                           Text="0000000.000"/>
                    <Label x:Name="LblShippedReceivedCounted"
                           Grid.Row="1"
                           Grid.Column="0"
                           FontAttributes="Bold"
                           Text="Shipped"/>
                    <Label x:Name="LblShippedReceivedCountedData"
                           Grid.Row="1"
                           Grid.Column="1"
                           Text="0000000.000"/>
                </Grid>
                <!--SID-->
                <Grid Grid.Row="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="LblComment"
                           Grid.Row="0"
                           Grid.Column="0"
                           FontAttributes="Bold"
                           Text="Comment"/>
                    <Label x:Name="LblCommentData"
                           Grid.Row="0"
                           Grid.Column="1"
                           Text="None"/>
                    <Label x:Name="LblSchemeId"
                           Grid.Row="1"
                           Grid.Column="0"
                           FontAttributes="Bold"
                           Text="SID"/>
                    <Label x:Name="LblSchemeIdData"
                           Grid.Row="1"
                           Grid.Column="1"
                           Text="Unknown"/>
                </Grid>
                <!--Items, AddItem, Details-->
                <Grid Grid.Row="7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CmdAddItem"
                            Grid.Row="0"
                            Grid.Column="0"
                            Clicked="CmdAddItem_Click"
                            FontAttributes="Bold"
                            Text="Add Item"
                            IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                    <Button x:Name="CmdAddDetail"
                            Grid.Row="0"
                            Grid.Column="1"
                            Clicked="CmdAddDetail_Clicked"
                            FontAttributes="Bold"
                            Text="Add Detail"
                            IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                    <Button x:Name="CmdDetails"
                            Grid.Row="0"
                            Grid.Column="2"
                            Clicked="CmdDetails_Click"
                            FontAttributes="Bold"
                            Text="Details"
                            IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                </Grid>

                <!--First, Previous, Next, Last-->
                <Grid Grid.Row="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CmdFirst"
                            Grid.Row="0"
                            Grid.Column="0"
                            Clicked="CmdFirst_Click"
                            FontAttributes="Bold"
                            Text="First"
                            IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                    <Button x:Name="CmdPrevious"
                            Grid.Row="0"
                            Grid.Column="1"
                            Clicked="CmdPrevious_Click"
                            FontAttributes="Bold"
                            Text="Prev"
                            IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                    <Button x:Name="CmdItems"
                            Grid.Row="0"
                            Grid.Column="2"
                            Clicked="CmdItems_Click"
                            FontAttributes="Bold"
                            Text="Items"
                            IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                    <Button x:Name="CmdNext"
                            Grid.Row="0"
                            Grid.Column="3"
                            Clicked="CmdNext_Click"
                            FontAttributes="Bold"
                            Text="Next"
                            IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                    <Button x:Name="CmdLast"
                            Grid.Row="0"
                            Grid.Column="4"
                            Clicked="CmdLast_Click"
                            FontAttributes="Bold"
                            Text="Last"
                            IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                </Grid>
            </Grid>

            <ActivityIndicator IsVisible="{Binding IsIndicatorRunning}" 
                                   IsRunning="{Binding IsIndicatorRunning}"
                                   AbsoluteLayout.LayoutFlags="All" 
                                   AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</modal:DMobileModal>