<?xml version="1.0" encoding="utf-8" ?>
<custompages:DMobileContentPage  
    xmlns:custompages="clr-namespace:dMobile.View.CustomPages"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:dMobile.View.Helpers" xmlns:modal="clr-namespace:dMobile.View.CustomPages.Modal"
    x:Class="dMobile.View.Activity.ActivityMoveInventory">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="OptionsMenu"
                     IconImageSource="{Binding OptionsIconSource}"
                     Clicked="OptionsMenu_Clicked" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <AbsoluteLayout VerticalOptions="Center">
            <Grid x:Name="GridContainer"
                  Padding="10"
                  AbsoluteLayout.LayoutFlags="All"
                  AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="CmdFromLocation"
                        Clicked="CmdFromLocation_Click"
                        Grid.Row="0"
                        IsEnabled="{Binding Loading, Converter={helpers:BoolConverter}}"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="ChkScanToLocation"
                              Grid.Column="0"
                              VerticalOptions="Center"
                              IsEnabled="{Binding Loading, Converter={helpers:BoolConverter}}"/>
                    <Label x:Name="LblScanToLocation" Grid.Column="1" VerticalOptions="Center"/>
                    <Picker x:Name="BarCodeModifier1Picker"
                            Grid.Column="2"
                            IsEnabled="{Binding Loading, Converter={helpers:BoolConverter}}"/>
                    <Button x:Name="CmdAdd"
                            Grid.Column="3"
                            Clicked="CmdAdd_Click"
                            IsEnabled="{Binding Loading, Converter={helpers:BoolConverter}}"/>
                </Grid>

                <Frame Grid.Row="2" OutlineColor="{DynamicResource BorderColor}">
                    <ScrollView Orientation="Horizontal">
                        <Grid x:Name="GridMainActivity">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListView x:Name="ListViewMainActivity"
                                      ItemSelected="ListViewMainActivity_ItemSelected"
                                      HasUnevenRows="True"
                                      IsEnabled="{Binding Loading, Converter={helpers:BoolConverter}}"
                                      Grid.Row="0"/>
                        </Grid>
                    </ScrollView>
                </Frame>

                <Frame Grid.Row="3" OutlineColor="{DynamicResource BorderColor}">
                    <ListView x:Name="ListViewDisplayExtraInfo"
                              SelectionMode="None"
                              HasUnevenRows="True"
                              IsEnabled="{Binding Loading, Converter={helpers:BoolConverter}}"
                              SeparatorVisibility="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="5,1,5,1">
                                        <Label Text="{Binding}" VerticalOptions="Center"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Frame>

                <Button x:Name="CmdToLocation"
                        Grid.Row="4"
                        Clicked="CmdToLocation_Click"
                        IsEnabled="{Binding Loading, Converter={helpers:BoolConverter}}"/>
                <Button x:Name="CmdPerformMove"
                        Grid.Row="5"
                        Clicked="CmdPerformMove_Clicked"
                        IsEnabled="{Binding Loading, Converter={helpers:BoolConverter}}"/>
            </Grid>

            <ActivityIndicator IsVisible="{Binding Loading}" 
                               IsRunning="{Binding Loading}"
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</custompages:DMobileContentPage>