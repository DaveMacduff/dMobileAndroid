<?xml version="1.0" encoding="utf-8" ?>
<custompages:DMobileContentPage  xmlns:custompages="clr-namespace:dMobile.View.CustomPages"
                                 xmlns="http://xamarin.com/schemas/2014/forms"
                                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
                                 xmlns:Helpers="clr-namespace:dMobile.View.Helpers"
                                 x:Class="dMobile.View.Activity.ActivitySkidPutAway">
    <!--<ContentPage.ToolbarItems>
        <ToolbarItem x:Name="optionsMenu"
                    IconImageSource="{Binding OptionsIconSource}"
                    Clicked="OptionsMenu_Clicked"
                    IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
    </ContentPage.ToolbarItems>-->
    <ContentPage.Content>
        <AbsoluteLayout VerticalOptions="Center">
            <Grid Padding="10" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Frame VerticalOptions="Start" OutlineColor="{DynamicResource BorderColor}" Grid.Row="0">
                    <ScrollView Orientation="Horizontal">
                        <Grid x:Name="GridMainActivity">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListView x:Name="ListViewMainActivity"
                                      HasUnevenRows="True"
                                      IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"
                                      Grid.Row="1"/>
                        </Grid>
                    </ScrollView>
                </Frame>

                <Frame VerticalOptions="Start" Grid.Row="1" OutlineColor="{DynamicResource BorderColor}">
                    <ListView x:Name="ListViewDisplayExtraInfo"
                              SelectionMode="None"
                              HasUnevenRows="True"
                              IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"
                              SeparatorVisibility="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="5,1,5,1">
                                        <Label Text="{Binding}" VerticalTextAlignment="Center"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Frame>

                <StackLayout Grid.Row="2">
                    <Grid>
                        <Picker x:Name="BarCodeModifier1Picker"
                                Grid.Row="0"
                                Grid.Column="0"
                                IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                        <Button x:Name="cmdAddProduct"
                                Grid.Row="0"
                                Grid.Column="1"
                                Clicked="cmdAddProduct_Click"
                                IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>

                        <Button x:Name="cmdLocation" 
                                Grid.Row="1"
                                Grid.Column="0"
                                Clicked="cmdLocation_Click"
                                IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                        <Button x:Name="cmdSelectSkid"
                                Grid.Row="1"
                                Grid.Column="1"
                                Clicked="cmdSelectSkid_Click"
                                IsEnabled="{Binding IsIndicatorRunning, Converter={Helpers:BoolConverter}}"/>
                    </Grid>
                </StackLayout>

            </Grid>

            <ActivityIndicator IsVisible="{Binding IsIndicatorRunning}"
                               IsRunning="{Binding IsIndicatorRunning}"
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</custompages:DMobileContentPage>