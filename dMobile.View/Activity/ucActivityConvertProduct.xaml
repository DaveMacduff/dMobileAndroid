<?xml version="1.0" encoding="utf-8" ?>
<custompages:DMobileContentPage  xmlns:custompages="clr-namespace:dMobile.View.CustomPages" 
                                 xmlns="http://xamarin.com/schemas/2014/forms"
                                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                 xmlns:Helpers="clr-namespace:dMobile.View.Helpers" 
                                 xmlns:customcontrols="clr-namespace:dMobile.View.CustomControls"
                                 x:Class="dMobile.View.Activity.ucActivityConvertProduct">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="optionsMenu" IconImageSource="{Binding OptionsIconSource}" Clicked="optionsMenu_Clicked" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <AbsoluteLayout VerticalOptions="Center">
            <Grid x:Name="gridContainer" Padding="10" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Frame VerticalOptions="Start" Grid.Row="0" OutlineColor="{DynamicResource BorderColor}">
                    <ListView x:Name="ListViewDisplayExtraInfo" SelectionMode="None" HasUnevenRows="true" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}" SeparatorVisibility="None" >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="5,1,5,1">
                                        <Label Text="{Binding}" VerticalTextAlignment="Center"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Frame>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70*"/>
                        <ColumnDefinition Width="30*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="cmdLocation" Grid.Row="0" Grid.Column="0" Clicked="cmdLocation_Click" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}"/>
                    <customcontrols:CustomPicker x:Name="BarCodeModifier1Picker" Grid.Row="0" Grid.Column="1" Image="arrow_drop_down" SelectedIndexChanged="BarCodeModifier1Picker_SelectedIndexChanged" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}"/>
                    <Button x:Name="cmdSelectFromProduct" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Clicked="cmdSelectFromUnit_Click" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}"/>
                    <Button x:Name="cmdSelectToProduct" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Clicked="cmdSelectToUnit_Click" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}"/>
                    <Button x:Name="cmdDetail" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Clicked="cmdDetail_Click" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}"/>
                </Grid>
            </Grid>

            <ActivityIndicator IsVisible="{Binding Loading}" 
                               IsRunning="{Binding Loading}"
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</custompages:DMobileContentPage>