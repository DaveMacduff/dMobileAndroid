<?xml version="1.0" encoding="utf-8" ?>
<modal:DMobileModal  xmlns:modal="clr-namespace:dMobile.View.CustomPages.Modal"
                     xmlns="http://xamarin.com/schemas/2014/forms"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     x:Class="dMobile.View.Activity.ucActivityDeboxLabelCount">
    <ContentPage.Content>
        <Grid HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
            <Label x:Name="labelQuantity" Grid.Row="0" Grid.Column="0"/>
            <Entry x:Name="entryQuantity" Grid.Row="0" Grid.Column="1" Keyboard="Numeric"/>
        </Grid>
    </ContentPage.Content>
</modal:DMobileModal>