<?xml version="1.0" encoding="utf-8" ?>
<modal:DMobileModal
    xmlns:modal="clr-namespace:dMobile.View.CustomPages.Modal"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Helpers="clr-namespace:dMobile.View.Helpers"
    x:Class="dMobile.View.Activity.ucActivityDetail">
    <ContentPage.Content>
        <AbsoluteLayout VerticalOptions="Center">
            <Grid x:Name="gridContainer" Padding="10" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Frame VerticalOptions="Start" Grid.Row="0" Grid.ColumnSpan="2" OutlineColor="{DynamicResource BorderColor}">
                    <Grid x:Name="dataGridMainActivityHeader">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListView x:Name="dataGridMainActivity" ItemSelected="DataGridMainActivity_ItemSelected" HasUnevenRows="True" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}" Grid.Row="1"/>
                    </Grid>
                </Frame>

                <Frame VerticalOptions="Start" Grid.Row="1" Grid.ColumnSpan="2" OutlineColor="{DynamicResource BorderColor}">
                    <ListView x:Name="lstDisplay" SelectionMode="None" HasUnevenRows="True" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}" SeparatorVisibility="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="5,1,5,1">
                                        <Label Text="{Binding}" VerticalTextAlignment="Center"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Frame>

                <Entry x:Name="txtSearchDetail" Grid.Row="2" Grid.Column="0" TextChanged="txtSearchHdr_TextChanged" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}"/>

                <Button x:Name="cmdSelectSkid" Grid.Row="3" Grid.Column="0" Text="Select Skid" Clicked="cmdSelectSkid_Click" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}"/>
                <Button x:Name="cmdLocation" Grid.Row="3" Grid.Column="1" Text="Set Location" Clicked="cmdLocation_Click" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}"/>

                <Button x:Name="cmdAddSkid" Grid.Row="4" Grid.Column="0" Text="Add Skid" Clicked="cmdAddSkid_Click" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}"/>
                <Button x:Name="cmdAddDetail" Grid.Row="4" Grid.Column="1" Text="Add Detail" Clicked="cmdAddDetail_Click" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}"/>


            </Grid>

            <ActivityIndicator IsVisible="{Binding Loading}" 
                               IsRunning="{Binding Loading}"
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</modal:DMobileModal>