<?xml version="1.0" encoding="utf-8" ?>
<modal:DMobileModal
    xmlns:modal="clr-namespace:dMobile.View.CustomPages.Modal"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Helpers="clr-namespace:dMobile.View.Helpers"
    x:Class="dMobile.View.Activity.ucActivityHdr">
    <ContentPage.Content>
        <AbsoluteLayout VerticalOptions="Center">
            <Grid x:Name="gridContainer" Padding="10" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Frame VerticalOptions="Start" Grid.Row="1" Grid.ColumnSpan="2" OutlineColor="{DynamicResource BorderColor}">
                    <ListView x:Name="dataGridMainActivity" x:FieldModifier="Public" ItemSelected="DataGridMainActivity_ItemSelected" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}" />
                </Frame>

                <ListView x:Name="lstDisplay" Grid.Row="2" Grid.ColumnSpan="2" SelectionMode="None" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Label Text="{Binding}" VerticalTextAlignment="Center"/>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Entry x:Name="txtSearchHdr" Grid.Row="3" Grid.Column="0" TextChanged="TxtSearchHdr_TextChanged" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}"/>
                <Button x:Name="cmdFilter" Grid.Row="3" Grid.Column="1" Text="Filter" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}"/>

                <Button x:Name="cmdAdd" Grid.Row="4" Grid.Column="0" Text="Add" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}"/>
                <Button x:Name="btnClose" Grid.Row="4" Grid.Column="1" Text="Close" Clicked="BtnClose_Clicked" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}"/>
            </Grid>

            <ActivityIndicator IsVisible="{Binding Loading}" 
                               IsRunning="{Binding Loading}"
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</modal:DMobileModal>