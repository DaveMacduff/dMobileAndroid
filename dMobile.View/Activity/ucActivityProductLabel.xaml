<?xml version="1.0" encoding="utf-8" ?>
<modal:DMobileModal  xmlns:modal="clr-namespace:dMobile.View.CustomPages.Modal"
                     xmlns="http://xamarin.com/schemas/2014/forms"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
                     xmlns:Helpers="clr-namespace:dMobile.View.Helpers" xmlns:customcontrols="clr-namespace:dMobile.View.CustomControls"
                     x:Class="dMobile.View.Activity.ucActivityProductLabel">
    <ContentPage.Content>
        <AbsoluteLayout VerticalOptions="Center">
            <Grid Padding="10" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60*"/>
                    <RowDefinition Height="25*"/>
                    <RowDefinition Height="15*"/>
                </Grid.RowDefinitions>

                <!--Row 0-->
                <ScrollView Grid.Row="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label x:Name="lblQuantity" Grid.Row="0" Grid.Column="0"/>
                        <Entry x:Name="txtAltQuantity" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Keyboard="Numeric"/>

                        <Label x:Name="lblWeight" Grid.Row="1" Grid.Column="0"/>
                        <Entry x:Name="txtWtQty" Grid.Row="1" Grid.Column="1" Keyboard="Numeric"/>
                        <Label x:Name="lblWtUnit" Grid.Row="1" Grid.Column="2"/>

                        <Label x:Name="lblSerialNo" Grid.Row="2" Grid.Column="0"/>
                        <customcontrols:CustomPicker x:Name="cboSerialNo" Image="arrow_drop_down" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"/>

                        <Label x:Name="lblProductionDate" Grid.Row="3" Grid.Column="0"/>
                        <DatePicker x:Name="dtProductionDate" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"/>

                        <Label x:Name="lblLotNo" Grid.Row="4" Grid.Column="0"/>
                        <customcontrols:CustomPicker x:Name="cboLotNo" Image="arrow_drop_down" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"/>

                        <Label x:Name="lblBestBeforeDate" Grid.Row="5" Grid.Column="0"/>
                        <DatePicker x:Name="dtBestBeforeDate" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"/>
                        
                        <Label x:Name="lblVariantCode" Grid.Row="6" Grid.Column="0"/>
                        <customcontrols:CustomPicker x:Name="cboVariantCode" Image="arrow_drop_down" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"/>
                    </Grid>
                </ScrollView>

                <!--Row 1-->
                <Frame Grid.Row="1" OutlineColor="{DynamicResource BorderColor}">
                    <ListView x:Name="ListViewDisplayExtraInfo" SelectionMode="None" HasUnevenRows="True" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}" SeparatorVisibility="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="5,1,5,1">
                                        <Label Text="{Binding}" VerticalOptions="Center"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Frame>
                
                <!--Row 2-->
                <Grid Grid.Row="2">
                    <Button x:Name="cmdSave" Grid.Row="0" Grid.Column="0" Clicked="cmdSave_Clicked"/>
                    <Button x:Name="cmdSelectProduct" Grid.Row="0" Grid.Column="1"/>
                </Grid>
            </Grid>

            <ActivityIndicator IsVisible="{Binding Loading}" IsRunning="{Binding Loading}" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</modal:DMobileModal>