<?xml version="1.0" encoding="utf-8" ?>
<modal:DMobileModal  xmlns:modal="clr-namespace:dMobile.View.CustomPages.Modal"
                     xmlns="http://xamarin.com/schemas/2014/forms"             
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:Helpers="clr-namespace:dMobile.View.Helpers"
                     x:Class="dMobile.View.Activity.ucActivityRemoveFromSkid">
    <ContentPage.Content>
        <AbsoluteLayout VerticalOptions="Center">
            <Grid Padding="10" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="65*"/>
                    <RowDefinition Height="20*"/>
                    <RowDefinition Height="15*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label x:Name="lblQty" Grid.Row="0" Grid.Column="0" VerticalOptions="Center"/>
                    <Entry x:Name="txtAltQty" Grid.Row="0" Grid.Column="1" Keyboard="Numeric" TextChanged="txtAltQty_TextChanged" Focused="txtAltQty_Focused" VerticalOptions="Center"/>
                    <Label x:Name="lblUnit" Grid.Row="0" Grid.Column="2" VerticalOptions="Center"/>

                    <Label x:Name="lblWeight" Grid.Row="1" Grid.Column="0" VerticalOptions="Center"/>
                    <Entry x:Name="txtWtQty" Grid.Row="1" Grid.Column="1" Keyboard="Numeric" TextChanged="txtWtQty_TextChanged" Focused="txtWtQty_Focused" VerticalOptions="Center"/>
                    <Label x:Name="lblWtUnit" Grid.Row="1" Grid.Column="2" VerticalOptions="Center"/>
                </Grid>

                <Frame Grid.Row="1" OutlineColor="{DynamicResource BorderColor}">
                    <ListView x:Name="lstDisplay" SelectionMode="None" HasUnevenRows="True" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}" SeparatorVisibility="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="5,1,5,1">
                                        <Label Text="{Binding}" VerticalTextAlignment="Center"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Frame>

                <Grid Grid.Row="2">
                    <Button x:Name="btnSave" Text="Save" Grid.Row="0" Grid.Column="0" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}" Clicked="btnSave_Clicked"/>
                    <Button x:Name="btnCancel" Text="Cancel" Grid.Row="0" Grid.Column="1" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}" Clicked="btnCancel_Clicked"/>
                </Grid>
            </Grid>

            <ActivityIndicator IsVisible="{Binding Loading}" 
                                   IsRunning="{Binding Loading}"
                                   AbsoluteLayout.LayoutFlags="All" 
                                   AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</modal:DMobileModal>