<?xml version="1.0" encoding="utf-8" ?>
<custompages:DMobileContentPage
    xmlns:custompages="clr-namespace:dMobile.View.CustomPages"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="dMobile.View.Menus.InventoryCountsMenu">
    <ContentPage.Content>
        <AbsoluteLayout>
            <StackLayout AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Button x:Name="cmdPhysicalCount" Clicked="cmdPhysicalCount_Click" Text="1) Movement" />
                <Button x:Name="cmdCycleCount" Clicked="cmdCycleCount_Click" Text="2) Convert Units (Break Case)" />
            </StackLayout>

            <ActivityIndicator IsVisible="{Binding IsIndicatorRunning}" 
                               IsRunning="{Binding IsIndicatorRunning}" 
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</custompages:DMobileContentPage>