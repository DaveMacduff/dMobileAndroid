<?xml version="1.0" encoding="utf-8" ?>
<custompages:DMobileContentPage  xmlns:custompages="clr-namespace:dMobile.View.CustomPages"
                                 xmlns="http://xamarin.com/schemas/2014/forms"
                                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                 x:Class="dMobile.View.Menus.SalesOrdersMenu">
    <ContentPage.Content>
        <AbsoluteLayout>
            <StackLayout AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Button x:Name="cmdPicking" Clicked="cmdPicking_Click" Text="1) Picking" />
                <Button x:Name="cmdReturns" Clicked="cmdReturns_Click" Text="2) Returns" />
                <Button x:Name="cmdReleaseByOrder" Clicked="cmdReleaseByOrder_Click" Text="3) Release By Order #" />
                <Button x:Name="cmdReleaseBySection" Clicked="cmdReleaseBySection_Click" Text="4) Release By Section" />
            </StackLayout>

            <ActivityIndicator IsVisible="{Binding IsPageLoading}" 
                               IsRunning="{Binding IsPageLoading}" 
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</custompages:DMobileContentPage>