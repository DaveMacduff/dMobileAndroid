<?xml version="1.0" encoding="utf-8" ?>
<custompages:DMobileContentPage
    xmlns:custompages="clr-namespace:dMobile.View.CustomPages"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="dMobile.View.Menus.UtilitiesMenu">
    <ContentPage.Content>
        <AbsoluteLayout>
            <StackLayout AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Button x:Name="cmdScanBarCodes" Clicked="cmdScanBarCodes_Click" Text="1) Scan Barcodes" />
                <Button x:Name="cmdProductLabels" Clicked="cmdProductLabels_Click" Text="2) Product Labels" />
                <Button x:Name="cmdAssignDefaultLocation" Clicked="cmdAssignDefaultLocation_Click" Text="3) Assign Default Locations" />
            </StackLayout>

            <ActivityIndicator IsVisible="{Binding Loading}" 
                               IsRunning="{Binding Loading}" 
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</custompages:DMobileContentPage>