<?xml version="1.0" encoding="utf-8" ?>
<custompages:DMobileContentPage
    xmlns:custompages="clr-namespace:dMobile.View.CustomPages"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="dMobile.View.Menus.ucInventoryMenu">
    <ContentPage.Content>
        <AbsoluteLayout>
            <StackLayout AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Button x:Name="cmdMovement" Clicked="cmdMovement_Click" Text="1) Movement" />
                <Button x:Name="cmdConvertUnits" Clicked="cmdConvertUnits_Click" Text="2) Convert Units (Break Case)" />
                <Button x:Name="cmdInventoryCounts" Clicked="cmdInventoryCounts_Click" Text="3) Counts" />
                <Button x:Name="cmdSkidMaintenance" Clicked="cmdSkidMaintenance_Click" Text="4) Skids" />
                <Button x:Name="cmdInquiry" Clicked="cmdInquiry_Click" Text="5) Inquiry" />
                <Button x:Name="cmdAdjustments" Clicked="cmdAdjustments_Click" Text="6) Adjustments" />
            </StackLayout>

            <ActivityIndicator IsVisible="{Binding Loading}" 
                               IsRunning="{Binding Loading}" 
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</custompages:DMobileContentPage>