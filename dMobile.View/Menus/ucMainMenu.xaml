<?xml version="1.0" encoding="utf-8" ?>
<custompages:DMobileContentPage
    xmlns:custompages="clr-namespace:dMobile.View.CustomPages"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"    
    x:Class="dMobile.View.Menus.ucMainMenu">
    <ContentPage.Content>
        <AbsoluteLayout>
            <StackLayout AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
                <Button x:Name="cmdPurchaseOrders" Clicked="cmdPurchaseOrders_Click" Text="1) Receiving And Put Away" />
                <Button x:Name="cmdSalesOrders" Clicked="cmdSalesOrders_Click" Text="2) Sales Orders" />
                <Button x:Name="cmdInventory" Clicked="cmdInventory_Click" Text="3) Inventory" />
                <Button x:Name="cmdProduction" Clicked="cmdProduction_Click" Text="4) Production" />
                <Button x:Name="cmdOptions" Clicked="cmdOptions_Click" Text="5) Options" />
            </StackLayout>

            <ActivityIndicator IsVisible="{Binding Loading}" 
                               IsRunning="{Binding Loading}" 
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</custompages:DMobileContentPage>