<?xml version="1.0" encoding="utf-8" ?>
<custompages:DMobileContentPage
             xmlns:custompages="clr-namespace:dMobile.View.CustomPages"
             xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dMobile.View.Menus.ucOptionsMenu">
    <ContentPage.Content>
        <AbsoluteLayout>
            <StackLayout AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
                    <Button x:Name="cmdSetupDefaults" Clicked="cmdSetupDefaults_Click" Text="1) Setup Defaults" />
                    <Button x:Name="cmdCommunicationSetup" Clicked="cmdCommunicationSetup_Click" Text="2) Comm, Setup" />
                    <Button x:Name="cmdRefreshData" Clicked="cmdRefreshData_Click" Text="3) Refresh Data" />
                    <Button x:Name="cmdSubmitBatch" Clicked="cmdSubmitBatch_Click" Text="4) Submit Batch" />
                    <Button x:Name="cmdUtilities" Clicked="cmdUtilities_Click" Text="5) Utilities" />
                    <Button x:Name="cmdAbout" Clicked="cmdAbout_Click" Text="6) About" />
                </StackLayout>

                <ActivityIndicator IsVisible="{Binding Loading}" 
                               IsRunning="{Binding Loading}" 
                               AbsoluteLayout.LayoutFlags="All" 
                               AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</custompages:DMobileContentPage>