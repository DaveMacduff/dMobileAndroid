<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dMobile.View.TestPage">
    <ContentPage.Content>
        <AbsoluteLayout VerticalOptions="Center">
                <!--<Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>-->
            <Grid AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1">
                <ScrollView Orientation="Horizontal">
                    <Grid>
                        <Label Text="Test0000000000000000000000000" VerticalTextAlignment="Center" Grid.Row="0" Grid.Column="0"/>
                        <Label Text="Test1111111111111111111111111" VerticalTextAlignment="Center" Grid.Row="0" Grid.Column="1"/>
                        <Label Text="Test2222222222222222222222222" VerticalTextAlignment="Center" Grid.Row="0" Grid.Column="2"/>
                        <Label Text="Test3333333333333333333333333" VerticalTextAlignment="Center" Grid.Row="0" Grid.Column="3"/>
                        <Label Text="Test4444444444444444444444444" VerticalTextAlignment="Center" Grid.Row="0" Grid.Column="4"/>
                        <Label Text="Test5555555555555555555555555" VerticalTextAlignment="Center" Grid.Row="0" Grid.Column="5"/>
                    </Grid>
                </ScrollView>
            </Grid>

            <ActivityIndicator IsVisible="{Binding Loading}" 
                                   IsRunning="{Binding Loading}"
                                   AbsoluteLayout.LayoutFlags="All" 
                                   AbsoluteLayout.LayoutBounds="0.5,0.5,0.3,0.3"/>
        </AbsoluteLayout>
    </ContentPage.Content>
</ContentPage>