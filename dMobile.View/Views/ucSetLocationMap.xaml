<?xml version="1.0" encoding="UTF-8"?>
<modal:DMobileTabbedModal
    xmlns:modal="clr-namespace:dMobile.View.CustomPages.Modal"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Helpers="clr-namespace:dMobile.View.Helpers"
    xmlns:customcontrols="clr-namespace:dMobile.View.CustomControls"
    x:Class="dMobile.View.ucSetLocationMap">

    <ContentPage x:Name="warehouseTab">
        <!--Warehouse tab-->
        <Grid Padding="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label x:Name="tabWarehouse" Text="Warehouse" Grid.Row="0" FontAttributes="Bold"/>

            <Frame Grid.Row="1" OutlineColor="{DynamicResource BorderColor}">
                <ListView x:Name="dgWhs" ItemSelected="dgWhs_ItemSelected" HasUnevenRows="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Grid Padding="5,1,5,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding LocationMapWarehouseCode}" VerticalOptions="Center"/>
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding LocationMapWarehouseName}" VerticalOptions="Center"/>
                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Frame>

            <customcontrols:LocationMapInfo x:Name="warehouseLocationMapInfo" Grid.Row="2"/>
        </Grid>
    </ContentPage>

    <ContentPage x:Name="sectionTab">
        <!--Section tab-->
        <Grid Padding="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label x:Name="tabSection" Text="Section" Grid.Row="0" FontAttributes="Bold"/>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*" />
                    <ColumnDefinition Width="35*" />
                    <ColumnDefinition Width="45*" />
                </Grid.ColumnDefinitions>

                <Label x:Name="lblSearch" Text="Search" Grid.Row="0" Grid.Column="0" VerticalOptions="Center"/>
                <customcontrols:CustomPicker x:Name="cboSectionSearch" Grid.Row="0" Grid.Column="1" FontSize="Body" Image="arrow_drop_down" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}"/>
                <Entry x:Name="txtSearchSection" Grid.Row="0" Grid.Column="2" TextChanged="txtSearchSection_TextChanged" IsEnabled="{Binding Loading, Converter={Helpers:BoolConverter}}"/>
            </Grid>

            <Frame VerticalOptions="Start" Grid.Row="2" OutlineColor="{DynamicResource BorderColor}">
                <ListView x:Name="dgSections" ItemSelected="dgSections_ItemSelected" HasUnevenRows="True" >
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Grid Padding="5,1,5,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0" Text="{Binding LocationMapSectionCode}" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding LocationMapSectionName}" VerticalOptions="Center"/>
                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Frame>

            <customcontrols:LocationMapInfo x:Name="sectionLocationMapInfo" Grid.Row="3"/>
        </Grid>
    </ContentPage>

    <ContentPage x:Name="slotTab">
        <!--Section Slot-->
        <Grid Padding="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label x:Name="tabSlot" Text="Slot" Grid.Row="0" FontAttributes="Bold"/>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--Coord1-->
                <Label x:Name="lblSlotCoordinate1" Grid.Row="0" Grid.Column="0" Text="Coord 1"/>
                <Entry x:Name="txtSlotCoordinate1" TextChanged="txtSlotCoordinate1_TextChanged" Grid.Row="1" Grid.Column="0"/>
                <Frame VerticalOptions="Start" Grid.Row="2" Grid.Column="0" OutlineColor="{DynamicResource BorderColor}">
                    <ListView x:Name="dgCoord1" ItemSelected="dgCoord1_ItemSelected" Grid.Row="3" Grid.Column="0" HasUnevenRows="True">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="5,1,5,1">
                                        <Label Text="{Binding LocationMapSlotCoordinateCode}" VerticalOptions="Center"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Frame>

                <!--Coord2-->
                <Label x:Name="lblSlotCoordinate2" Grid.Row="0" Grid.Column="1" Text="Coord 2"/>
                <Entry x:Name="txtSlotCoordinate2" TextChanged="txtSlotCoordinate2_TextChanged" Grid.Row="1" Grid.Column="1"/>
                <Frame VerticalOptions="Start" Grid.Row="2" Grid.Column="1" OutlineColor="{DynamicResource BorderColor}">
                    <ListView x:Name="dgCoord2" ItemSelected="dgCoord2_ItemSelected" Grid.Row="3" Grid.Column="1" HasUnevenRows="True">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="5,1,5,1">
                                        <Label Text="{Binding LocationMapSlotCoordinateCode}" VerticalOptions="Center"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Frame>

                <!--Coord2-->
                <Label x:Name="lblSlotCoordinate3" Grid.Row="0" Grid.Column="2" Text="Coord 3"/>
                <Entry x:Name="txtSlotCoordinate3" TextChanged="txtSlotCoordinate3_TextChanged" Grid.Row="1" Grid.Column="2"/>
                <Frame VerticalOptions="Start" Grid.Row="2" Grid.Column="2" OutlineColor="{DynamicResource BorderColor}">
                    <ListView x:Name="dgCoord3" ItemSelected="dgCoord3_ItemSelected" Grid.Row="3" Grid.Column="2" HasUnevenRows="True">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="5,1,5,1">
                                        <Label Text="{Binding LocationMapSlotCoordinateCode}" VerticalOptions="Center"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Frame>
            </Grid>

            <customcontrols:LocationMapInfo x:Name="slotLocationMapInfo" Grid.Row="2"/>
        </Grid>
    </ContentPage>

